#include <stdio.h>

// Display the array
void display(int arr[], int size)
{
    for (int i = 0; i < size; i++)
    {
        printf("%d ", arr[i]);
    }
    printf("\n");
}

// Insert an element
void insert(int arr[], int *size, int pos, int value)
{
    for (int i = *size; i > pos; i--)
    {
        arr[i] = arr[i - 1];
    }
    arr[pos] = value;
    (*size)++;
}

// Delete an element
void deleteElement(int arr[], int *size, int pos)
{
    for (int i = pos; i < *size - 1; i++)
    {
        arr[i] = arr[i + 1];
    }
    (*size)--;
}

// Linear Search
void linearSearch(int arr[], int size, int key)
{
    for (int i = 0; i < size; i++)
    {
        if (arr[i] == key)
        {
            printf("Element found at position %d\n", i + 1);
            return;
        }
    }
    printf("Element not found\n");
}

// Binary Search
void binarySearch(int arr[], int size, int key)
{
    int low = 0, high = size - 1;

    while (low <= high)
    {
        int mid = (low + high) / 2;

        if (arr[mid] == key)
        {
            printf("Element found at position %d\n", mid + 1);
            return;
        }
        else if (key < arr[mid])
        {
            high = mid - 1;
        }
        else
        {
            low = mid + 1;
        }
    }

    printf("Element not found\n");
}

int main()
{
    int arr[100] = {10, 20, 30, 40, 50};
    int size = 5;
    int pos = 3;
    int value = 25;
    int search1 = 40;
    int search2 = 50;

    printf("FEBINE M E 25BAD024\n");

    printf("\nOriginal Array:\n");
    display(arr, size);

    printf("\n--- Insert Operation ---\n");
    insert(arr, &size, pos - 1, value);
    printf("Array after insertion:\n");
    display(arr, size);

    printf("\n--- Delete Operation ---\n");
    deleteElement(arr, &size, 1);
    printf("Array after deletion:\n");
    display(arr, size);

    printf("\n--- Linear Search ---\n");
    linearSearch(arr, size, search1);

    printf("\n--- Binary Search ---\n");
    binarySearch(arr, size, search2);

    return 0;
}
